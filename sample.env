# Copy this file to .env for local testing:
#   cp sample.env .env
#
# Get your API key at: https://resend.com/api-keys
#
# For local testing without a verified domain, use:
#   MAIL_FROM=onboarding@resend.dev
# Resend will only deliver to the email address on your Resend account.
#
# For production, verify your domain in Resend and use e.g.:
#   MAIL_FROM=you@yourdomain.com

RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Global Mailer

# Per-app API keys — one env var per project that can send mail.
# Format: MAILER_KEY_<APP_NAME>=secret-key
# Remove a key from .env to revoke that app's access.
MAILER_KEY_BLOG=change-me-blog-secret
MAILER_KEY_PORTFOLIO=change-me-portfolio-secret
