# ─────────────────────────────────────────────────────────────
# Global Mailer — environment variables
# Copy to .env for local use:  cp example.env .env
# ─────────────────────────────────────────────────────────────

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Sender address
# Local testing (no domain needed):
MAIL_FROM=onboarding@resend.dev
# Production (after verifying your domain in Resend):
# MAIL_FROM=you@yourdomain.com

MAIL_FROM_NAME=Global Mailer

# Per-app API keys — one key per project that can call this mailer
# Format: MAILER_KEY_<APP_NAME>=secret
# Remove a line to revoke that app's access
MAILER_KEY_BLOG=change-me-blog-secret
MAILER_KEY_PORTFOLIO=change-me-portfolio-secret
MAILER_KEY_ECOMMERCE=change-me-ecommerce-secret
